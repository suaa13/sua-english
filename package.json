{
  "name": "sua-english-backend",
  "version": "0.1.0",
  "description": "SUA English — AI English Learning Platform backend (Phase 1: Auth + Users)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "prisma generate --schema prisma/schema.postgres.prisma && ts-node --transpile-only src/main.ts",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:pg": "prisma --schema prisma/schema.postgres.prisma",
    "prisma:dev": "prisma --schema prisma/schema.sqlite.prisma",
    "db:push": "prisma --schema prisma/schema.sqlite.prisma db push --skip-generate",
    "db:migrate": "prisma --schema prisma/schema.postgres.prisma migrate dev",
    "seed": "ts-node prisma/seed.ts",
    "seed:register": "DATABASE_URL=\"file:./dev.db\" node prisma/seed-register.cjs",
    "test": "prisma generate --schema prisma/schema.sqlite.prisma && jest --config ./test/jest-unit.json --runInBand",
    "test:e2e": "prisma generate --schema prisma/schema.sqlite.prisma && DATABASE_URL=\"file:./test.db\" prisma db push --schema prisma/schema.sqlite.prisma --accept-data-loss && jest --config ./test/jest-e2e.json --runInBand",
    "verify": "npm run db:push && npm run seed && npm run seed:register && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express-rate-limit": "^7.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.10",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
